# Keep deployment-only settings on the server. Do not commit the real .env file.

# Compose project name used by the deployment scripts.
COMPOSE_PROJECT_NAME=ai_literature

# Stable image names produced by docker compose build and exported by scripts/build-images.*.
BACKEND_IMAGE=ai_literature-backend:latest
WEB_IMAGE=ai_literature-web:latest

# Optional build mirror overrides, useful when Docker Hub access is unstable.
# BACKEND_BUILD_IMAGE=docker.m.daocloud.io/library/maven:3.9.12-eclipse-temurin-21-alpine
# BACKEND_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-alpine
# WEB_BUILD_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# WEB_RUNTIME_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# Branch pulled by scripts/deploy-prod.sh.
DEPLOY_BRANCH=main

# HTTP port exposed by the frontend container.
WEB_PORT=8088

# PostgreSQL settings.
POSTGRES_DB=demo_01
POSTGRES_USER=demo_01
POSTGRES_PASSWORD=demo_01

# Frontend public base path and API URL baked into the production bundle.
VITE_APP_BASE_PATH=/viteApp/
VITE_API_BASE_URL=/viteApp/api

# AI model settings.
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
BIGMODEL_API_KEY=your-bigmodel-api-key

APP_AI_RAG_GROBID_BASE_URL=http://grobid:8070
APP_AI_KG_ENABLED=false
APP_AI_KG_GRAPH_BUILDER_ENABLED=false
APP_AI_KG_GRAPH_BUILDER_ENDPOINT=

# Override only if you changed the vector table name from the application default.
APP_AI_RAG_VECTOR_TABLE=embedding_store

# Neo4j connection for graph retrieval.
SPRING_NEO4J_URI=
SPRING_NEO4J_USERNAME=
SPRING_NEO4J_PASSWORD=

# Leave empty for same-origin deployments behind the Apache gateway.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=

# Optional production bootstrap admin. Leave disabled unless you need first-login setup.
APP_USER_INIT_ADMIN_ENABLED=false
APP_USER_INIT_ADMIN_ACCOUNT=
APP_USER_INIT_ADMIN_PASSWORD=
APP_USER_INIT_ADMIN_NAME=
