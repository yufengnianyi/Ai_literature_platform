# Keep deployment-only settings on the server. Do not commit the real .env file.

# Compose project name used by the deployment scripts.
COMPOSE_PROJECT_NAME=ai_literature

# Branch pulled by scripts/deploy-prod.sh.
DEPLOY_BRANCH=main

# HTTP port exposed by the frontend container.
WEB_PORT=8088

# PostgreSQL settings.
POSTGRES_DB=demo_01
POSTGRES_USER=demo_01
POSTGRES_PASSWORD=demo_01

# Frontend public base path and API URL baked into the production bundle.
VITE_APP_BASE_PATH=/viteApp/
VITE_API_BASE_URL=/viteApp/api

# AI model settings.
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
BIGMODEL_API_KEY=your-bigmodel-api-key

# Use rebuild for the first empty-environment deployment, then switch back to if-empty.
APP_AI_RAG_BOOTSTRAP_MODE=if-empty

# Override only if you changed the vector table name from the application default.
APP_AI_RAG_VECTOR_TABLE=embedding_store

# Leave empty for same-origin deployments behind the Apache gateway.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
